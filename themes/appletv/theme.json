{
  "name": "AppleTv",
  "author": "Evolution-555",
  "description": "Authentic Apple TV experience with glassmorphism, signature blue glow, spring animations. Optimized for 4K displays (3840x2160).",
  "colors": {
    "night": "#000000",
    "panel": "#1c1c1e",
    "ink": "#f5f5f7",
    "accent": "#0a84ff",
    "focus": "#0a84ff",
    "pill": "#ffffff"
  },
  "surface": {
    "pillAlpha": 0.15,
    "pillRing": 0.2,
    "pillRadius": 32,
    "menuAlpha": 0.95,
    "rowRadius": 30
  },
  "type": {
    "font": "default",
    "scale": 1
  },
  "clock": {
    "show": true,
    "date": true,
    "greeting": false,
    "layout": "inline",
    "anchor": "top",
    "align": "left",
    "x": 96,
    "y": 54,
    "scale": 1,
    "dateScale": 1
  },
  "bar": {
    "show": true,
    "style": "pill",
    "labels": "auto",
    "anchor": "top",
    "align": "right",
    "x": 96,
    "y": 54,
    "size": 64,
    "gap": 16
  },
  "shelf": {
    "show": true,
    "align": "left",
    "x": 96,
    "y": 150,
    "scale": 1
  },
  "dock": {
    "anchor": "bottom",
    "align": "center",
    "x": 0,
    "y": 60,
    "gap": 24,
    "tileRadius": 56,
    "tileFocusScale": 1.08
  },
  "grid": {
    "columns": 10,
    "gap": 24,
    "tileRadius": 56,
    "tileFocusScale": 1.08
  },
  "speed": {
    "focus": 1,
    "open": 1,
    "scroll": 1
  },
  "glow": {
    "opacity": 1,
    "size": 40,
    "blur": 20
  }
}
